; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Life Sim Prototype"
run/main_scene="res://ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

TimeManager="*res://autoload/time_manager.gd"
EventBus="*res://autoload/event_bus.gd"
GameRules="*res://autoload/game_rules.gd"
RelationshipManager="*res://autoload/relationship_manager.gd"
WorldState="*res://autoload/world_state.gd"
AudioManager="*res://autoload/audio_manager.gd"
CommunityEventManager="*res://autoload/community_event_manager.gd"
FarmingManager="*res://autoload/farming_manager.gd"
AdventureManager="*res://autoload/adventure_manager.gd"
PlayerStats="*res://autoload/player_stats.gd"
RetroPS2="*res://character/toriyama/retro_ps2.gd"
TraitSystem="*res://autoload/trait_system.gd"
Progression="*res://autoload/progression.gd"
TownGrowth="*res://autoload/town_growth.gd"
Hardships="*res://autoload/hardships.gd"
PowerSystem="*res://autoload/power_system.gd"
BuildingDamage="*res://autoload/building_damage.gd"
NetworkManager="*res://autoload/network_manager.gd"
QuestManager="*res://autoload/quest_manager.gd"
Economy="*res://autoload/economy.gd"
JobManager="*res://autoload/job_manager.gd"
InventoryManager="*res://autoload/inventory_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
PlayerFriendshipManager="*res://autoload/player_friendship_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[filesystem]

import/blender/enabled=false

