[node name="HelpText" type="Label" parent="Root/HelpPanel"]
offset_left = 16.0
offset_top = 42.0
offset_right = 584.0
offset_bottom = 310.0
theme_override_font_sizes/font_size = 16
text = "WASD — Move
Mouse — Look
Space — Jump
E — Interact / Talk / Pick Up / Close Dialogue
F — Invite (they'll come when free)
G — Follow Me (right now, if free) / Stop Following
Left Click — Shoot (while holding the ball)
M — Co-op visits (host / join)
Q — Mount / Dismount skateboard
1 / 2 / 3 — Normal / Fast / Very Fast time
P — Pause / Resume time
I — Toggle wardrobe (test equipping clothes/items)
J — Toggle social inspector (nearest resident)
Arrow Keys — Play notes during the guitar activity
Tab — Tool wheel: Empty Hands / Sword / Guitar
R — Play the guitar anywhere (bonus at the concert stage)
K or Left Click — Sword attack (sword in hand)
Shift — Dodge (brief invulnerability)
H — Toggle this help panel
Esc — Release / capture mouse (needed to click HUD buttons)"

